# =========================================================================
# Ocean Serenity Cruise Ship Management — Environment Variables Template
# =========================================================================

PORT=5001
NODE_ENV=development

# 🐘 PostgreSQL Configuration (Legacy Source Database)
DB_NAME=cruisemanagement
DB_USER=postgres
DB_PASSWORD=user123
DB_HOST=localhost
DB_PORT=5432

# 🔥 Firebase Cloud Firestore Configurations
# (Optional: Only required if serviceAccountKey.json is NOT placed in the backend/ folder)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=your-firebase-client-email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nYOUR_PRIVATE_KEY_HERE\\n-----END PRIVATE KEY-----\\n"

# 📧 Mail Server Configurations
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-email-app-password
# MAIL_FROM_EMAIL=no-reply@oceanserenity.com
